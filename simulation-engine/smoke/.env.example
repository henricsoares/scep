# Backend reached from the operator host.
BACKEND_URL=http://localhost:8000

# Use either an existing administrator JWT or administrator login credentials.
# SMOKE_ADMIN_JWT=replace-with-a-local-jwt
SMOKE_ADMIN_EMAIL=admin@example.com
SMOKE_ADMIN_PASSWORD=replace-with-admin-password

# The helper reuses this EVDriver by email or creates it when it does not exist.
# Supply a password that satisfies SPEC-005 when creation or login is required.
# SMOKE_DRIVER_ID=00000000-0000-0000-0000-000000000001
# SMOKE_DRIVER_JWT=replace-with-a-local-jwt
SMOKE_DRIVER_EMAIL=spec013-smoke-driver@example.com
SMOKE_DRIVER_PASSWORD=replace-with-driver-password
SMOKE_DRIVER_DISPLAY_NAME="SPEC-013 Smoke Driver"

# Existing IDs are optional. Missing resources are discovered by the stable names
# below or created through public APIs. No cleanup is performed.
# SMOKE_FACILITY_ID=00000000-0000-0000-0000-000000000002
SMOKE_FACILITY_NAME="SPEC-013 Smoke Facility"
# SMOKE_STATION_ID=00000000-0000-0000-0000-000000000003
SMOKE_STATION_SERIAL=SCEP-SPEC013-SMOKE-1
# SMOKE_CONNECTOR_ID=00000000-0000-0000-0000-000000000004
# SMOKE_VEHICLE_ID=00000000-0000-0000-0000-000000000005
SMOKE_VEHICLE_NAME="SPEC-013 Smoke Vehicle"

# This Monday-to-Tuesday UTC window produces one flow at Monday 12:00 UTC.
SMOKE_LOGICAL_START_AT=2026-01-05T00:00:00Z
SMOKE_LOGICAL_END_AT=2026-01-06T00:00:00Z
SMOKE_SESSION_HOUR=12
SMOKE_SESSIONS_PER_WEEK=1

# Override to keep multiple independent runs, for example runtime-restart.
# SMOKE_RUNTIME_DIR=/absolute/path/to/runtime-restart
