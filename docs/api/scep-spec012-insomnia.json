        "mimeType": "application/json",
        "text": "{\n  \"email\": \"{{ _.driver_email }}\",\n  \"password\": \"{{ _.driver_password }}\"\n}"
      },
      "authentication": {},
      "preRequestScript": "",
      "afterResponseScript": "insomnia.test('EVDriver login returns 200', () => insomnia.expect(insomnia.response.code, 'Set driver_email/driver_password for an active EVDriver').to.eql(200));\nif (insomnia.response.code === 200) insomnia.baseEnvironment.set('driver_token', insomnia.response.json().access_token);\n",
      "metaSortKey": 2000
    },
    {
      "_id": "req_spec012_03_publish",
      "_type": "request",
      "parentId": "fld_spec012_flow",
      "name": "03 - Publish Complete Weekly Profile",
      "method": "POST",
      "url": "{{ _.backend_url }}/predictions/weekly-occupancy-publications",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "X-Request-ID",
          "value": "spec012-{{ _.run_id }}-publish"
        }
      ],
      "parameters": [],
      "body": {
        "mimeType": "application/json",
        "text": "{{ _.validated_publication_payload }}"
      },
      "authentication": {
        "type": "bearer",
        "token": "{{ _.access_token }}"
      },
      "preRequestScript": "const raw = insomnia.baseEnvironment.get('publication_payload');\nconst payload = typeof raw === 'string' ? JSON.parse(raw) : raw;\nconst facilityId = insomnia.baseEnvironment.get('facility_id');\nconst timezone = insomnia.baseEnvironment.get('timezone');\nif (!facilityId) throw new Error('facility_id must be set before publication');\nif (!timezone) throw new Error('timezone must be set before publication');\npayload.facility_id = facilityId;\npayload.timezone = timezone;\nlet scopeQuery = `scope_type=${payload.scope_type}&facility_id=${facilityId}`;\nif (payload.scope_type === 'FACILITY') {\n  delete payload.station_id;\n  delete payload.connector_id;\n} else {\n  const stationId = insomnia.baseEnvironment.get('station_id');\n  if (!stationId) throw new Error('station_id must be set for STATION or CONNECTOR publication');\n  payload.station_id = stationId;\n  scopeQuery += `&station_id=${stationId}`;\n  if (payload.scope_type === 'CONNECTOR') {\n    const connectorId = insomnia.baseEnvironment.get('connector_id');\n    if (!connectorId) throw new Error('connector_id must be set for CONNECTOR publication');\n    payload.connector_id = connectorId;\n    scopeQuery += `&connector_id=${connectorId}`;\n  } else {\n    delete payload.connector_id;\n  }\n}\nif (!Array.isArray(payload.buckets) || payload.buckets.length !== 168) throw new Error('publication_payload must contain exactly 168 buckets');\nconst keys = new Set(payload.buckets.map(item => `${item.day_of_week}:${item.hour_of_day}`));\nif (keys.size !== 168) throw new Error('publication_payload buckets must be unique');\ninsomnia.baseEnvironment.set('publication_scope_query', scopeQuery);\ninsomnia.baseEnvironment.set('validated_publication_payload', JSON.stringify(payload));\n",
      "afterResponseScript": "const body = insomnia.response.json();\ninsomnia.test('publication returns 201 or an idempotent 200', () => insomnia.expect([200, 201]).to.include(insomnia.response.code));\nif ([200, 201].includes(insomnia.response.code)) { insomnia.expect(body.bucket_count).to.eql(168); insomnia.baseEnvironment.set('publication_id', body.id); }\n",
      "metaSortKey": 3000
    },
