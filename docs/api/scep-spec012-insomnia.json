      "_type": "request_group",
      "parentId": "wrk_scep_spec012",
      "name": "SPEC-012 External Publication and Consumption",
      "description": "Set Facility hierarchy values and EVDriver credentials. Replace publication_payload with prediction.json from the Python job for the research flow, then run requests in order. The bundled 168-bucket payload is only a contract fixture and is not a fitted model result."
    },
    {
      "_id": "req_spec012_01_publisher_login",
      "_type": "request",
      "parentId": "fld_spec012_flow",
      "name": "01 - Authenticate Prediction Publisher",
      "method": "POST",
      "url": "{{ _.backend_url }}/auth/login",
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "X-Request-ID",
          "value": "spec012-{{ _.run_id }}-login"
        }
      ],
      "parameters": [],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"{{ _.publisher_email }}\",\n  \"password\": \"{{ _.publisher_password }}\"\n}"
      },
      "authentication": {},
      "preRequestScript": "const runId = Date.now().toString();\ninsomnia.baseEnvironment.set('run_id', runId);\ninsomnia.baseEnvironment.set('access_token', '');\ninsomnia.baseEnvironment.set('driver_token', '');\ninsomnia.baseEnvironment.set('publication_id', '');\ninsomnia.baseEnvironment.set('publication_scope_query', '');\ninsomnia.baseEnvironment.set('validated_publication_payload', '');\n",
      "afterResponseScript": "insomnia.test('prediction publisher login returns 200', () => insomnia.expect(insomnia.response.code, 'Use an active PlatformAdministrator, DataScientist or AIResearchEnvironment credential').to.eql(200));\nif (insomnia.response.code === 200) insomnia.baseEnvironment.set('access_token', insomnia.response.json().access_token);\n",
      "metaSortKey": 1000
